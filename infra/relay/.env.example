# Required: Relay API and managed tunnel domains
# Production adopts retained DNS zones in your Cloudflare account. The API
# zone serves relay.<zone> in production and relay-<stage>.<zone> for personal
# stages. Managed environment endpoints are provisioned below the tunnel zone.
RELAY_API_ZONE_NAME=example.com
RELAY_TUNNEL_ZONE_NAME=tunnels.example.com

# Optional: Relay domain override
# Set this only when the derived relay hostname should not be used.
# RELAY_DOMAIN=relay.example.com

# Required: Clerk
# Get the keys from the Clerk Dashboard under API keys. Set the JWT audience to
# the `aud` claim configured on the `t3-relay` JWT template.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWT_AUDIENCE=t3-code-relay
# Comma-separated Clerk user IDs (`user_...`). Whitespace and duplicates are
# ignored. Empty or absent disables the Salvo operator API.
SALVO_OPERATOR_USER_IDS=
# Comma-separated Clerk user IDs admitted to the private Salvo pilot. Empty or
# absent admits nobody; operator membership does not imply pilot membership.
SALVO_PILOT_USER_IDS=

# Optional: Salvo hosted AWS sandboxes. The provider remains unavailable unless
# every AWS, gateway, and temporary-credential value is present. IDs must use
# their normal AWS formats (ami-..., lt-..., subnet-..., sg-...); launch template
# version is a positive integer. The launch template owns encrypted EBS,
# hibernation, networking, and the instance profile; the Worker does not accept
# arbitrary launch overrides.
SALVO_AWS_REGION=us-east-1
SALVO_AWS_PROMOTED_AMI_ID=ami-...
SALVO_AWS_IMAGE_RELEASE=salvo-...
SALVO_AWS_LAUNCH_TEMPLATE_ID=lt-...
SALVO_AWS_LAUNCH_TEMPLATE_VERSION=1
SALVO_AWS_INSTANCE_TYPE=t3.medium
SALVO_AWS_SUBNET_ID=subnet-...
SALVO_AWS_SECURITY_GROUP_ID=sg-...
SALVO_AWS_INSTANCE_PROFILE_ARN=arn:aws:iam::123456789012:instance-profile/salvo-sandbox
# JSON on one line. expiresAt is ISO-8601 UTC and must be between 1 minute and
# 12 hours in the future. Rotate this temporary IAM session before expiry; never
# replace it with a long-lived access key. Restrict it to Salvo's EC2 allowlist.
SALVO_AWS_TEMPORARY_CREDENTIALS={"accessKeyId":"...","secretAccessKey":"...","sessionToken":"...","expiresAt":"..."}
# HTTPS control-plane origin plus an opaque bearer token. Rotate the token when
# personnel or gateway access changes and deploy both ends during the overlap.
SALVO_SANDBOX_GATEWAY_ORIGIN=https://sandbox-control.example.com
SALVO_SANDBOX_GATEWAY_TOKEN=...
# 32-byte hex key used to encrypt one-time sandbox control secrets at rest.
SALVO_SANDBOX_BOOTSTRAP_MASTER_KEY=...
# Optional assertion only. When set, this must exactly match the route mounted
# on the relay public origin: https://relay.example.com/v1/sponsored-inference/execute
# The worker derives and writes that canonical URL into sandbox bootstrap state.
SALVO_INFERENCE_GATEWAY_URL=https://relay.example.com/v1/sponsored-inference/execute

# Optional: centrally sponsored OpenAI inference. Either set every value below
# or leave every value absent; partial or unsafe configuration stops deployment.
# Models are a comma-separated allowlist. Token and micro-dollar values are
# positive integers. Caps must satisfy turn <= user <= pilot. Hard parser limits:
# output tokens <= 100000, timeout <= 120000 ms, attempts <= 3, grant TTL <=
# 3600000 ms. Example rates are placeholders—set them from the current model
# price sheet before enabling the pilot. Rotate the API key through the provider
# and deployment secret store; never place a real key in this file or source.
SALVO_OPENAI_API_KEY=...
SALVO_SPONSORED_MODELS=gpt-5.1-codex-mini
SALVO_SPONSORED_MAX_OUTPUT_TOKENS=8192
SALVO_SPONSORED_TURN_MICROS=500000
SALVO_SPONSORED_USER_MICROS=5000000
SALVO_SPONSORED_PILOT_MICROS=25000000
SALVO_SPONSORED_INPUT_MICROS_PER_MILLION_TOKENS=250000
SALVO_SPONSORED_OUTPUT_MICROS_PER_MILLION_TOKENS=2000000
SALVO_SPONSORED_TIMEOUT_MS=60000
SALVO_SPONSORED_MAX_ATTEMPTS=2
SALVO_SPONSORED_GRANT_TTL_MS=300000

# Disabled unless explicitly set to 1. This uses a dedicated short-lived bearer,
# never a Clerk, sandbox, AWS, or model-provider credential. A deployment exposes
# only gates backed by installed deterministic scenario adapters.
SALVO_GAUNTLET_ENABLED=0
SALVO_GAUNTLET_PROBE_TOKEN=replace-with-at-least-32-random-bytes
SALVO_GAUNTLET_SOURCE_REVISION=replace-with-promoted-source-revision
SALVO_GAUNTLET_RUNTIME_IMAGE_ID=replace-with-promoted-runtime-image-id
SALVO_GAUNTLET_SKILL_RELEASE_HASH=replace-with-64-character-sha256
SALVO_GAUNTLET_INFRASTRUCTURE_PLAN_HASH=replace-with-64-character-sha256
SALVO_GAUNTLET_SPEC_HASH=replace-with-64-character-sha256
SALVO_GAUNTLET_EVIDENCE_COLLECTOR_ID=replace-with-versioned-collector-id
# Set to 1 only after the staging deployment topology has been independently attested.
SALVO_GAUNTLET_PRODUCTION_EQUIVALENT=0

# Required: Apple Push Notification service
# Get these values from your Apple Developer account. Use `sandbox` for
# development APNs credentials and `production` for production credentials.
APNS_ENVIRONMENT=sandbox
APNS_TEAM_ID=...
APNS_KEY_ID=...
APNS_BUNDLE_ID=...
APNS_PRIVATE_KEY=...
