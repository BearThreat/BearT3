[Unit]
Description=Salvo outbound sandbox tunnel
After=network-online.target salvo-bootstrap.service salvo.service
Wants=network-online.target
Requires=salvo-bootstrap.service salvo.service
ConditionPathExists=/etc/salvo/tunnel-token

[Service]
Type=simple
User=salvo
Group=salvo
ExecStart=/opt/salvo/runtime/cloudflared tunnel --no-autoupdate --protocol http2 --metrics 127.0.0.1:49312 run --token-file /etc/salvo/tunnel-token
Restart=on-failure
RestartSec=2
TimeoutStartSec=45
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/salvo/tunnel-token

[Install]
WantedBy=multi-user.target
